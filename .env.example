# ===================================================
# MALABAR PICKLE - 100% FREE PERMANENT DATABASE STORAGE
# ===================================================
# Connect either Vercel KV or Upstash Redis (both are 100% FREE forever).
# Once added in Vercel Settings -> Environment Variables, your data NEVER resets!

KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
KV_REST_API_TOKEN=YourSecretUpstashTokenHere

# Optional Upstash Redis alternative key names:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
